# Dependencies
node_modules/

# Build output (dist/ is regenerated by `npm run build`; the repo-root
# index.html bundle is synced separately via `npm run pages:sync`)
dist/

# Local API dev state (npm run dev:api persistence)
.dev-data/

# Environment / secrets
.env
.env.*
!.env.example

# Local design-review screenshots (generated by headless-browser passes)
.design-shots-*
